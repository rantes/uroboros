<dmb-simple-form redirect="/admin/projects" close-panel="#panel-form-add-edit-reg">
    <dmb-form
        id="form-project"
        name="project"
        action="/admin/saveproject"
        method="post"
        async>
        <header>
            <dmb-close-panel orientation="right"></dmb-close-panel>
            <h3><?= $this->title; ?></h3>
        </header>
        <dmb-content>
            <div class="section group">
                <? if (!empty($this->data->id)): ?>
                <dmb-input type="hidden" dmb-name="project[id]" dmb-value="<?= $this->data->id; ?>"></dmb-input>
                <? endif; ?>
                <div class="col col12">
                    <dmb-input
                        label="Nombre"
                        dmb-name="project[name]"
                        dmb-value="<?= $this->data->name; ?>"
                        validate="required">
                    </dmb-input>
                </div>
                <div class="col col12">
                    <dmb-textarea
                        label="Descripción"
                        dmb-name="project[description]"
                        dmb-value="<?= $this->data->description; ?>">
                    </dmb-textarea>
                </div>
                <div class="col col12">
                    <dmb-input
                        label="Repositorio"
                        dmb-name="project[repository_url]"
                        dmb-value="<?= $this->data->repository_url; ?>">
                    </dmb-input>
                </div>
                <div class="col col6 col6-md col6-sm">
                    <dmb-select label="Tipo" dmb-name="project[type]" dmb-value="<?= $this->data->type; ?>" validate="required">
                        <option value="">Seleccione...</option>
                        <option value="backend">Backend</option>
                        <option value="frontend">Frontend</option>
                        <option value="library">Library</option>
                        <option value="mobile">Mobile</option>
                    </dmb-select>
                </div>
                <div class="col col6 col6-md col6-sm">
                    <dmb-select label="Estado" dmb-name="project[status]" dmb-value="<?= $this->data->status; ?>" validate="required">
                        <? foreach ($this->statuses as $value => $label): ?>
                        <option value="<?= $value; ?>"><?= $label; ?></option>
                        <? endforeach; ?>
                    </dmb-select>
                </div>
                <div class="col col12">
                    <dmb-select label="Grupos" dmb-name="project[groups][]" dmb-value='<?= json_encode($this->selectedGroupIds); ?>' multiple>
                        <? foreach ($this->groups as $group): ?>
                        <option value="<?= $group->id; ?>"><?= $group->name; ?></option>
                        <? endforeach; ?>
                    </dmb-select>
                </div>
            </div>
        </dmb-content>
        <dmb-footer class="section group">
            <div class="col col6">
                <dmb-button type="reset">Cancelar</dmb-button>
            </div>
            <div class="col col6">
                <dmb-button type="submit">Guardar</dmb-button>
            </div>
        </dmb-footer>
    </dmb-form>
</dmb-simple-form>
