<dmb-simple-form <?= !empty($this->data->id) ? 'update' : ''; ?> redirect="/admin/project_credentials?project_id=<?= $this->data->project_id ?: $this->projectId; ?>" close-panel="#panel-form-add-edit-reg">
    <dmb-form
        id="form-project-credential"
        name="project_credential"
        action="/admin/project_credentials"
        method="post"
        async>
        <header>
            <dmb-close-panel orientation="right"></dmb-close-panel>
            <h3><?= $this->title; ?></h3>
        </header>
        <dmb-content>
            <div class="section group">
                <? if (!empty($this->data->id)): ?>
                <dmb-input type="hidden" dmb-name="project_credential[id]" dmb-value="<?= $this->data->id; ?>"></dmb-input>
                <? endif; ?>
                <dmb-input
                    type="hidden"
                    dmb-name="project_credential[project_id]"
                    dmb-value="<?= $this->data->project_id ?: $this->projectId; ?>">
                </dmb-input>
                <div class="col col12">
                    <dmb-input
                        label="Nombre"
                        dmb-name="project_credential[name]"
                        dmb-value="<?= htmlspecialchars((string) $this->data->name, ENT_QUOTES, 'UTF-8'); ?>"
                        placeholder="github_token"
                        validate="required">
                    </dmb-input>
                </div>
                <div class="col col12">
                    <dmb-input
                        type="password"
                        label="<?= !empty($this->data->id) ? 'Nuevo valor (sobrescribe el actual)' : 'Valor'; ?>"
                        dmb-name="project_credential[value]"
                        validate="required">
                    </dmb-input>
                </div>
            </div>
        </dmb-content>
        <dmb-footer class="section group">
            <div class="col col6">
                <dmb-button type="reset">Cancelar</dmb-button>
            </div>
            <div class="col col6">
                <dmb-button type="submit">Guardar</dmb-button>
            </div>
        </dmb-footer>
    </dmb-form>
</dmb-simple-form>
